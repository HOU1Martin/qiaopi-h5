/**catalog.wxss**/
page { height: 100vh; overflow: hidden; background: #2c1810; }
.catalog-page { position: relative; width: 100%; height: 100vh; overflow: hidden; }

/* ===== 流动背景 ===== */
.catalog-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; }
.catalog-bg-img { width: 100%; height: 100%; filter: sepia(30%) brightness(0.35) contrast(1.1);
  animation: bgDrift 30s ease-in-out infinite alternate; }
@keyframes bgDrift { 0% { transform: scale(1.05) translate(0, 0); }
  100% { transform: scale(1.15) translate(-2%, -1%); } }
.catalog-bg-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(44,24,16,0.55) 0%, rgba(44,24,16,0.85) 40%, rgba(44,24,16,0.95) 100%); }

/* ===== 前景内容（可滚动） ===== */
.catalog-content { position: relative; z-index: 2; height: 100%; overflow-y: scroll; padding-bottom: 60rpx; }

/* ===== 标题渐显 ===== */
.catalog-hero { padding: 100rpx 40rpx 50rpx; text-align: center; opacity: 0; transform: translateY(-30rpx);
  transition: opacity 1.2s ease, transform 1.2s ease; }
.catalog-hero.visible { opacity: 1; transform: translateY(0); }
.catalog-subtitle { font-size: 24rpx; color: #d4a860; letter-spacing: 14rpx; }
.catalog-title { display: block; font-size: 64rpx; color: #f5e6d3; font-weight: bold; letter-spacing: 14rpx;
  margin: 28rpx 0; text-shadow: 0 4rpx 20rpx rgba(0,0,0,0.6); }
.catalog-hero-line { display: flex; align-items: center; justify-content: center; gap: 16rpx; }
.catalog-hero-dash { color: #d4a860; font-size: 24rpx; }
.catalog-hero-text { font-size: 28rpx; color: #d4a860; letter-spacing: 18rpx; font-weight: bold; }

/* ===== 卡片列表 ===== */
.catalog-list { padding: 0 40rpx; }
.catalog-item { display: flex; align-items: center; padding: 28rpx 24rpx; margin-bottom: 18rpx;
  background: rgba(245,230,211,0.06); border: 1rpx solid rgba(212,168,96,0.12); border-radius: 10rpx;
  backdrop-filter: blur(8rpx); -webkit-backdrop-filter: blur(8rpx);
  opacity: 0; transform: translateX(60rpx); transition: opacity 0.7s ease, transform 0.7s ease, background 0.3s; }
.catalog-item.visible { opacity: 1; transform: translateX(0); }
.catalog-item:active { background: rgba(212,168,96,0.15); border-color: rgba(212,168,96,0.4); transform: scale(0.98); }
.catalog-item-num { flex-shrink: 0; width: 90rpx; text-align: center; }
.catalog-num-cn { display: block; font-size: 40rpx; color: #d4a860; font-weight: bold; }
.catalog-num-en { display: block; font-size: 18rpx; color: rgba(212,168,96,0.5); letter-spacing: 2rpx; margin-top: 2rpx; }
.catalog-item-body { flex: 1; display: flex; flex-direction: column; padding: 0 20rpx;
  border-left: 2rpx solid rgba(212,168,96,0.2); }
.catalog-item-title { font-size: 28rpx; color: #f5e6d3; font-weight: bold; letter-spacing: 2rpx; line-height: 38rpx; }
.catalog-item-sub { font-size: 22rpx; color: rgba(245,230,211,0.5); letter-spacing: 1rpx; margin-top: 6rpx; }
.catalog-item-arrow { width: 50rpx; height: 50rpx; border-radius: 50%;
  background: rgba(212,168,96,0.12); display: flex; align-items: center; justify-content: center; }
.arrow-icon { font-size: 24rpx; color: #d4a860; }

/* ===== 底部 ===== */
.catalog-footer { text-align: center; padding: 60rpx 40rpx 80rpx; opacity: 0;
  transform: translateY(30rpx); transition: opacity 1s ease 0.6s, transform 1s ease 0.6s; }
.catalog-footer.visible { opacity: 1; transform: translateY(0); }
.catalog-footer-quote { font-size: 26rpx; color: rgba(212,168,96,0.5); letter-spacing: 8rpx; }
