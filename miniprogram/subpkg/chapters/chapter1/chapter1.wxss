/**chapter1.wxss**/

/* ========== 页面 ========== */
page {
  height: auto;
  background: #2c1810;
  overflow-y: scroll;
}
.chapter1-page {
  width: 100%;
  min-height: 100vh;
  background: #681d00;
  color: #f5e6d3;
}

/* ========== Hero 首屏 ========== */
.hero-section {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}
.hero-image {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  filter: sepia(20%) brightness(0.5) contrast(1.15);
  animation: heroZoom 20s ease-in-out infinite alternate;
}
@keyframes heroZoom {
  0%   { transform: scale(1); }
  100% { transform: scale(1.1); }
}
.hero-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(
    180deg,
    rgba(218, 107, 63, 0.35) 0%,
    rgba(233, 79, 18, 0.55) 50%,
    rgba(131, 38, 1, 0.95) 100%
  );
}
.hero-content {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -55%);
  width: 80%;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
}
.hero-subtitle {
  font-size: 28rpx;
  color: #d4a860;
  letter-spacing: 12rpx;
  margin-bottom: 36rpx;
  opacity: 0;
  animation: fadeDown 1s 0.2s forwards;
}
.hero-title {
  font-size: 96rpx;
  color: #f5e6d3;
  font-weight: bold;
  letter-spacing: 16rpx;
  text-shadow: 0 4rpx 24rpx rgba(5, 2, 0, 0.855);
  opacity: 0;
  animation: fadeIn 1.2s 0.4s forwards;
}
.hero-title-cn {
  font-size: 64rpx;
  color: #d4a860;
  font-weight: bold;
  letter-spacing: 24rpx;
  margin-top: 12rpx;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.5);
  opacity: 0;
  animation: fadeIn 1.2s 0.6s forwards;
}
.hero-divider {
  width: 0;
  height: 1rpx;
  background: #d4a860;
  margin: 36rpx 0;
  animation: expandLine 1s 1s forwards;
}
.hero-desc {
  font-size: 28rpx;
  color: rgba(245, 230, 211, 0.85);
  letter-spacing: 6rpx;
  opacity: 0;
  animation: fadeIn 1.2s 1.2s forwards;
}
.scroll-hint {
  position: absolute;
  bottom: 60rpx; left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
  opacity: 0;
  animation: fadeIn 1.2s 1.6s forwards;
}
.scroll-hint-text {
  font-size: 24rpx;
  color: rgba(245, 230, 211, 0.5);
  letter-spacing: 4rpx;
  margin-bottom: 14rpx;
}
.scroll-hint-arrow {
  width: 2rpx;
  height: 30rpx;
  background: #d4a860;
  position: relative;
  animation: arrowBounce 1.8s ease-in-out infinite;
}
.scroll-hint-arrow::after {
  content: '';
  position: absolute;
  bottom: 0; left: 50%;
  width: 12rpx; height: 12rpx;
  border-right: 2rpx solid #d4a860;
  border-bottom: 2rpx solid #d4a860;
  transform: translateX(-50%) rotate(45deg);
}
@keyframes arrowBounce {
  0%, 100% { transform: translateY(0); opacity: 0.5; }
  50%      { transform: translateY(12rpx); opacity: 1; }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes fadeDown {
  from { opacity: 0; transform: translateY(-24rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes expandLine {
  from { width: 0; opacity: 0; }
  to   { width: 80rpx; opacity: 1; }
}

/* ========== 通用 section 渐显 ========== */
.section {
  padding: 80rpx 40rpx;
  position: relative;
  opacity: 0;
  transform: translateY(60rpx);
  transition: opacity 1s ease, transform 1s ease;
}
.section.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ========== 简介部分（无标题） ========== */
.intro-section {
  padding: 80rpx 50rpx;
  margin: 0 30rpx;
  margin-top: 40rpx;
  background: rgba(178, 61, 6, 0.234);
  border: 1rpx solid rgba(212, 168, 96, 0.2);
  position: relative;
}
.intro-corner {
  position: absolute;
  width: 30rpx; height: 30rpx;
  border-color: #d4a860;
  border-style: solid;
}
.corner-tl { top: -2rpx; left: -2rpx; border-width: 2rpx 0 0 2rpx; }
.corner-tr { top: -2rpx; right: -2rpx; border-width: 2rpx 2rpx 0 0; }
.corner-bl { bottom: -2rpx; left: -2rpx; border-width: 0 0 2rpx 2rpx; }
.corner-br { bottom: -2rpx; right: -2rpx; border-width: 0 2rpx 2rpx 0; }

.intro-quote {
  display: block;
  font-size: 36rpx;
  color: #d4a860;
  font-weight: bold;
  letter-spacing: 4rpx;
  line-height: 60rpx;
  text-align: center;
  font-style: italic;
}
.intro-divider {
  width: 60rpx;
  height: 2rpx;
  background: #d4a860;
  margin: 30rpx auto;
  opacity: 0.5;
}
.intro-text {
  font-size: 30rpx;
  line-height: 56rpx;
  color: rgba(245, 230, 211, 0.85);
  letter-spacing: 2rpx;
  text-indent: 2em;
}
.intro-em {
  color: #d4a860;
  font-weight: bold;
}

/* ========== 侨批原信图片 ========== */
.archive-section {
  padding: 40rpx 30rpx 60rpx;
}
.archive-frame {
  position: relative;
  padding: 30rpx 30rpx 36rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(212, 168, 96, 0.3);
  border-radius: 6rpx;
}
.archive-corner {
  position: absolute;
  width: 28rpx; height: 28rpx;
  border-color: #d4a860;
  border-style: solid;
}
.archive-tag {
  position: absolute;
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #2c1810;
  padding: 4rpx 20rpx;
  border: 1rpx solid #d4a860;
  border-radius: 4rpx;
  z-index: 2;
}
.archive-tag-text {
  font-size: 22rpx;
  color: #d4a860;
  letter-spacing: 6rpx;
}
.archive-image {
  display: block;
  width: 100%;
  height: 800rpx;
  background: #1a0e08;
  border: 1rpx solid rgba(212, 168, 96, 0.2);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.5);
  filter: sepia(8%) brightness(1.02);
}
.archive-caption {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
}
.archive-caption-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(212, 168, 96, 0.4), transparent);
}
.archive-caption-text {
  padding: 0 20rpx;
  font-size: 24rpx;
  color: rgba(245, 230, 211, 0.7);
  letter-spacing: 4rpx;
  font-style: italic;
}

/* ========== 南洋家人照片 ========== */
.family-section {
  margin: 30rpx 0;
  padding: 30rpx 30rpx 36rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(212, 168, 96, 0.3);
  border-radius: 6rpx;
  position: relative;
  opacity: 0;
  transform: translateY(40rpx);
  transition: opacity 1s ease, transform 1s ease;
}
.family-section.visible {
  opacity: 1;
  transform: translateY(0);
}
.family-frame {
  position: relative;
}
.family-image {
  display: block;
  width: 100%;
  background: #cda38d;
  border: 1rpx solid rgba(212, 168, 96, 0.25);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.6);
  filter: sepia(12%) contrast(1.05) brightness(0.98);
}
.family-caption {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
}
.family-caption-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(212, 168, 96, 0.4), transparent);
}
.family-caption-text {
  padding: 0 20rpx;
  font-size: 24rpx;
  color: rgba(245, 230, 211, 0.7);
  letter-spacing: 3rpx;
  font-style: italic;
}

/* ========== 信纸通用 ========== */
.letter-header {
  text-align: center;
  margin-bottom: 40rpx;
}
.letter-header-text {
  font-size: 48rpx;
  color: #d4a860;
  font-weight: bold;
  letter-spacing: 20rpx;
  padding: 0 30rpx;
  border-bottom: 2rpx solid rgba(212, 168, 96, 0.4);
  padding-bottom: 16rpx;
}

/* ========== 释文信纸 ========== */
.letter-paper {
  background: linear-gradient(180deg,
    rgba(245, 235, 220, 0.12) 0%,
    rgba(245, 235, 220, 0.08) 100%
  );
  border: 1rpx solid rgba(212, 168, 96, 0.25);
  border-radius: 8rpx;
  padding: 60rpx 40rpx 50rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.4);
  position: relative;
  background-image:
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 55rpx,
      rgba(212, 168, 96, 0.04) 55rpx,
      rgba(212, 168, 96, 0.04) 56rpx
    );
}
.letter-salute {
  display: block;
  font-size: 32rpx;
  line-height: 56rpx;
  color: #f5e6d3;
  font-weight: bold;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
}
.letter-body {
  display: block;
  font-size: 30rpx;
  line-height: 58rpx;
  color: rgba(245, 230, 211, 0.88);
  letter-spacing: 1rpx;
  text-indent: 2em;
  margin-bottom: 16rpx;
}
.letter-note-ref {
  font-size: 26rpx;
  color: #a0a0a0;
  letter-spacing: 0;
}
.letter-note-num {
  font-size: 22rpx;
  color: #d4a860;
  letter-spacing: 0;
}
.letter-respects {
  margin: 24rpx 0;
}
.letter-respects .letter-body {
  text-indent: 0;
  margin-bottom: 6rpx;
}
.letter-signature {
  text-align: right;
  margin: 30rpx 0 20rpx;
}
.letter-signature .letter-body {
  text-indent: 0;
  margin-bottom: 4rpx;
}
.letter-strike {
  color: rgba(245, 230, 211, 0.6) !important;
  font-style: italic;
}
.letter-separator {
  display: flex;
  align-items: center;
  margin: 40rpx 0 30rpx;
}
.letter-separator::before,
.letter-separator::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: rgba(212, 168, 96, 0.35);
}
.letter-separator-text {
  padding: 0 30rpx;
  font-size: 26rpx;
  color: #d4a860;
  letter-spacing: 12rpx;
  font-weight: bold;
}
.envelope-text {
  font-weight: bold;
  font-size: 32rpx !important;
}
.letter-auspice {
  display: flex;
  justify-content: center;
  margin: 30rpx 0 24rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(212, 168, 96, 0.2);
  border-bottom: 1rpx solid rgba(212, 168, 96, 0.2);
}
.letter-auspice-text {
  font-size: 40rpx;
  color: #d4a860;
  font-weight: bold;
  letter-spacing: 24rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}
.letter-date {
  text-align: right;
  color: rgba(245, 230, 211, 0.7) !important;
  margin-top: 10rpx;
}

/* ========== 注解部分 ========== */
.notes-list {
  margin-bottom: 40rpx;
}
.note-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(212, 168, 96, 0.1);
  opacity: 0;
  transform: translateX(-20rpx);
  transition: opacity 0.6s ease, transform 0.6s ease;
}
.note-item.visible {
  opacity: 1;
  transform: translateX(0);
}
.note-item:last-child {
  border-bottom: none;
}
.note-num {
  flex-shrink: 0;
  width: 48rpx;
  font-size: 26rpx;
  color: #d4a860;
  font-weight: bold;
  letter-spacing: 2rpx;
}
.note-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 48rpx;
  color: rgba(245, 230, 211, 0.82);
  letter-spacing: 1rpx;
}
.note-bold {
  color: #d4a860;
  font-weight: bold;
}
.notes-conclusion {
  background: rgba(255, 255, 255, 0.04);
  border-left: 3rpx solid #d4a860;
  padding: 30rpx 30rpx;
  margin-top: 30rpx;
  border-radius: 0 8rpx 8rpx 0;
  opacity: 0;
  transform: translateY(30rpx);
  transition: opacity 0.8s ease, transform 0.8s ease;
}
.notes-conclusion.visible {
  opacity: 1;
  transform: translateY(0);
}
.conclusion-text {
  font-size: 28rpx;
  line-height: 52rpx;
  color: rgba(245, 230, 211, 0.85);
  letter-spacing: 1rpx;
  text-indent: 2em;
}

/* ========== 结尾 ========== */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 60rpx 120rpx;
}
.footer-divider {
  width: 120rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #d4a860, transparent);
  margin-bottom: 50rpx;
}
.footer-seal {
  width: 120rpx;
  height: 120rpx;
  background: #a52a2a;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.4);
  margin-bottom: 30rpx;
  transform: rotate(-3deg);
}
.footer-seal-text {
  font-size: 56rpx;
  color: #f5e6d3;
  font-weight: bold;
  font-family: serif;
  letter-spacing: 4rpx;
}
.footer-text {
  font-size: 32rpx;
  color: #f5e6d3;
  font-weight: bold;
  letter-spacing: 8rpx;
  margin-bottom: 12rpx;
}
.footer-sub {
  font-size: 24rpx;
  color: rgba(212, 168, 96, 0.7);
  letter-spacing: 4rpx;
  font-style: italic;
}

/* ========== 底部导航按钮 ========== */
.nav-buttons {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(212, 168, 96, 0.2);
}
.nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 32rpx;
  border: 1rpx solid rgba(212, 168, 96, 0.4);
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.06);
  font-size: 28rpx;
  letter-spacing: 4rpx;
  transition: background 0.3s ease, border-color 0.3s ease;
}
.nav-btn::after {
  border: none;
}
.nav-btn:active {
  background: rgba(212, 168, 96, 0.15);
  border-color: #d4a860;
}
.nav-btn-back {
  color: rgba(245, 230, 211, 0.85);
}
.nav-btn-next {
  color: #d4a860;
  border-color: #d4a860;
  font-weight: bold;
}
.nav-btn-label {
  font-size: 28rpx;
  letter-spacing: 4rpx;
}
.nav-btn-icon {
  font-size: 32rpx;
  line-height: 1;
}
.nav-btn-icon-back {
  margin-right: 12rpx;
}
.nav-btn-icon-next {
  margin-left: 12rpx;
}

/* ========== 悬浮目录按钮 ========== */
.float-catalog {
  position: fixed;
  bottom: 280rpx;
  right: 30rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(26, 10, 8, 0.85);
  border: 1rpx solid rgba(212, 168, 96, 0.5);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  transition: background 0.3s ease, transform 0.2s ease;
}
.float-catalog:active { background: rgba(212, 168, 96, 0.3); transform: scale(0.92); }
.float-catalog-icon { font-size: 26rpx; color: #d4a860; font-weight: bold; letter-spacing: 2rpx; line-height: 1; }

/* ========== 悬浮回到首页按钮 ========== */
.float-home {
  position: fixed;
  bottom: 180rpx;
  right: 30rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(26, 10, 8, 0.85);
  border: 1rpx solid rgba(212, 168, 96, 0.5);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  transition: background 0.3s ease, transform 0.2s ease;
}
.float-home:active { background: rgba(212, 168, 96, 0.3); transform: scale(0.92); }
.float-home-icon { font-size: 26rpx; color: #d4a860; font-weight: bold; letter-spacing: 2rpx; line-height: 1; }
