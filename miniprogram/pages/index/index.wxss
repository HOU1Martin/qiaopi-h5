/**index.wxss**/
page { height: 100vh; overflow: hidden; background: #2c1810; }
.page-root { position: relative; width: 100%; height: 100vh; overflow: hidden; }

/* ========== 流动背景 ========== */
.bg-layer { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; }
.bg-image { width: 100%; height: 100%; filter: sepia(20%) brightness(0.45);
  animation: bgFloat 25s ease-in-out infinite alternate; }
@keyframes bgFloat { 0% { transform: scale(1.05); } 100% { transform: scale(1.12) translate(-1%, -0.5%); } }
.bg-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(44,24,16,0.5) 0%, rgba(44,24,16,0.75) 60%, rgba(44,24,16,0.92) 100%); }

/* ========== 水波纹涟漪 ========== */
.ripple { position: absolute; width: 0; height: 0; border-radius: 50%;
  border: 2rpx solid rgba(212,168,96,0.6);
  transform: translate(-50%, -50%);
  animation: rippleOut 1.2s ease-out forwards; pointer-events: none; }
@keyframes rippleOut {
  0%   { width: 0; height: 0; opacity: 0.8; }
  100% { width: 300rpx; height: 300rpx; opacity: 0; border-width: 0; }
}

/* ========== 标题渐显 ========== */
.title-area { position: absolute; top: 8%; left: 50%; transform: translateX(-50%); z-index: 2;
  text-align: center; opacity: 0; transition: opacity 1.2s ease, transform 1.2s ease;
  transform: translate(-50%, -30rpx); }
.title-area.visible { opacity: 1; transform: translate(-50%, 0); }
.title-main { display: block; font-size: 40rpx; color: #f5e6d3; font-weight: bold;
  letter-spacing: 8rpx; text-shadow: 0 4rpx 16rpx rgba(0,0,0,0.6); }
.title-sub { display: block; font-size: 24rpx; color: #d4a860;
  letter-spacing: 14rpx; margin-top: 16rpx; }

/* ========== 主交互区 ========== */
.main-area { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  z-index: 2; width: 85%; display: flex; flex-direction: column; align-items: center;
  opacity: 0; transition: opacity 1.5s ease 0.3s; }
.main-area.visible { opacity: 1; }

/* ========== 用户信息卡片 ========== */
.userinfo { display: flex; flex-direction: column; align-items: center; width: 100%;
  background: rgba(255,255,255,0.12); backdrop-filter: blur(20rpx); -webkit-backdrop-filter: blur(20rpx);
  border-radius: 24rpx; border: 1rpx solid rgba(255,255,255,0.2);
  padding: 40rpx 30rpx 50rpx; box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.3); }
.userinfo-guide { margin-bottom: 24rpx; text-align: center; }
.guide-text { display: block; font-size: 26rpx; color: rgba(245,230,211,0.8); letter-spacing: 4rpx; line-height: 42rpx; }
.guide-em { color: #d4a860; font-weight: bold; font-size: 30rpx; letter-spacing: 6rpx; }

.userinfo-avatar { overflow: hidden; width: 140rpx; height: 140rpx; margin: 20rpx;
  border-radius: 50%; border: 4rpx solid rgba(255,255,255,0.5);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.3); }
.userinfo-nickname { color: #f5e6d3; font-size: 32rpx; font-weight: bold; margin-top: 10rpx; }

.avatar-wrapper { padding: 0 !important; width: 140rpx !important; height: 140rpx !important;
  border-radius: 50% !important; border: 4rpx solid rgba(255,255,255,0.4) !important;
  background: rgba(255,255,255,0.2) !important; overflow: hidden; margin: 20rpx 0; }
.avatar { display: block; width: 140rpx; height: 140rpx; }
.nickname-wrapper { display: flex; align-items: center; width: 100%; padding: 16rpx 0; margin-top: 20rpx;
  border-top: 1rpx solid rgba(255,255,255,0.2); border-bottom: 1rpx solid rgba(255,255,255,0.2); color: #ffe2ba; }
.nickname-label { width: 100rpx; font-size: 28rpx; color: rgba(255,255,255,0.7); }
.nickname-input { flex: 1; font-size: 28rpx; color: #f5e6d3; background: rgba(255,255,255,0.1);
  border-radius: 12rpx; padding: 12rpx 20rpx; }
.userinfo button { background: rgba(255,255,255,0.2); color: #f5e6d3;
  border: 1rpx solid rgba(255,255,255,0.3); border-radius: 16rpx; font-size: 30rpx; padding: 20rpx 50rpx; }

/* ========== 鎏金进入按钮 ========== */
.enter-btn { position: relative; width: 280rpx; height: 100rpx; line-height: 100rpx;
  font-size: 36rpx; font-weight: bold; color: #2c1810; background: linear-gradient(135deg, #f5e6d3 0%, #d4a860 50%, #b8803a 100%);
  border: none; border-radius: 50rpx; margin: 40rpx 0 10rpx; overflow: visible; }
.enter-btn::after { border: none; }
.enter-btn-text { position: relative; z-index: 2; text-shadow: 0 2rpx 4rpx rgba(255,255,255,0.3); }
.enter-btn-glow { position: absolute; top: -8rpx; left: -8rpx; right: -8rpx; bottom: -8rpx;
  border-radius: 56rpx; background: transparent; z-index: 0;
  box-shadow: 0 0 30rpx rgba(212,168,96,0.6), 0 0 60rpx rgba(212,168,96,0.3), 0 0 100rpx rgba(180,120,50,0.2);
  animation: glowPulse 2s ease-in-out infinite alternate; }
@keyframes glowPulse {
  0% { box-shadow: 0 0 20rpx rgba(212,168,96,0.4), 0 0 40rpx rgba(212,168,96,0.2); transform: scale(1); }
  100% { box-shadow: 0 0 40rpx rgba(212,168,96,0.7), 0 0 80rpx rgba(212,168,96,0.4), 0 0 120rpx rgba(180,120,50,0.3);
    transform: scale(1.03); }
}

/* ========== Motto ========== */
.usermotto { margin-top: 40rpx; text-align: center; }
.user-motto { font-size: 28rpx; color: rgba(245,230,211,0.7);
  text-shadow: 1rpx 1rpx 4rpx rgba(0,0,0,0.5); letter-spacing: 2rpx; }

/* ========== 信封弹窗 ========== */
.envelope-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.7); z-index: 999; display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none; transition: opacity 0.5s ease; }
.envelope-overlay.show { opacity: 1; pointer-events: auto; }
.envelope-card { position: relative; width: 520rpx; padding: 60rpx 40rpx 50rpx;
  background: linear-gradient(180deg, #faf3e6 0%, #e8d5b0 40%, #d4c090 100%);
  border-radius: 16rpx; border: 3rpx solid #c4a060;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.5);
  display: flex; flex-direction: column; align-items: center;
  animation: envelopeBounce 0.6s ease-out; }
@keyframes envelopeBounce {
  0%   { transform: scale(0.3); opacity: 0; }
  50%  { transform: scale(1.05); }
  100% { transform: scale(1); opacity: 1; }
}
.envelope-card::before { content: ''; position: absolute; top: 12rpx; left: 12rpx; right: 12rpx; bottom: 12rpx;
  border: 2rpx dashed rgba(180,120,60,0.3); border-radius: 10rpx; pointer-events: none; }

.envelope-close { position: absolute; top: 16rpx; right: 24rpx; width: 48rpx; height: 48rpx;
  background: rgba(180,100,40,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: #8b4513; z-index: 2; }
.envelope-stamp { width: 120rpx; height: 120rpx; border-radius: 50%; border: 4rpx solid #d4a860;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.3); overflow: hidden; margin-bottom: 20rpx; }
.envelope-avatar { width: 100%; height: 100%; }
.envelope-name { font-size: 36rpx; color: #3a1a0a; font-weight: bold; letter-spacing: 6rpx; }
.envelope-divider { width: 80rpx; height: 2rpx; background: linear-gradient(90deg, transparent, #d4a860, transparent); margin: 20rpx 0; }
.envelope-welcome { font-size: 28rpx; color: #5a3a1a; letter-spacing: 8rpx; }
.envelope-visitor { font-size: 26rpx; color: #6b4226; margin-top: 12rpx; letter-spacing: 4rpx; }
.envelope-num { color: #c0392b; font-size: 40rpx; font-weight: bold; font-family: serif; }
.envelope-seal { position: absolute; bottom: -30rpx; right: 30rpx; width: 80rpx; height: 80rpx;
  background: #c0392b; border-radius: 6rpx; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.4); transform: rotate(-8deg); }
.envelope-seal-text { font-size: 36rpx; color: #f5e6d3; font-weight: bold; font-family: serif; }
